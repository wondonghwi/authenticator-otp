#!/usr/bin/env python3
"""Generate a local TOTP from a macOS Keychain generic password."""

import argparse
import base64
import binascii
import hashlib
import hmac
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import NamedTuple, Optional
from urllib.parse import parse_qs, urlparse


class OTPError(Exception):
    """An error safe to show without revealing the stored secret."""


class OTPConfig(NamedTuple):
    key: bytes
    algorithm: str
    digits: int
    period: int


def validate_identifier(value: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._@-]{0,127}", value):
        raise argparse.ArgumentTypeError(
            "Use 1-128 ASCII letters, digits, dots, underscores, @ or hyphens; "
            "start with a letter or digit."
        )
    return value


def keychain_get(service: str, account: str, keychain: Path) -> str:
    result = subprocess.run(
        [
            "/usr/bin/security", "find-generic-password",
            "-s", service, "-a", account, "-w", str(keychain),
        ],
        capture_output=True, text=True,
    )
    if result.returncode:
        raise OTPError(
            "Cannot read the Keychain item. Check its name/account, unlock the "
            "keychain, and review the macOS access prompt."
        )
    if not result.stdout.strip():
        raise OTPError("The Keychain item has an empty password.")
    return result.stdout.strip()


def parse_secret(raw: str, algorithm=None, digits=None, period=None) -> OTPConfig:
    raw = raw.strip()
    if len(raw) > 8192:
        raise OTPError("The stored secret is too long.")
    parameters = {}
    if raw.lower().startswith("otpauth:"):
        try:
            uri = urlparse(raw)
            if uri.scheme != "otpauth" or uri.netloc != "totp" or not uri.path:
                raise OTPError("Only otpauth://totp/ URIs are supported.")
            parameters = parse_qs(uri.query, keep_blank_values=True)
        except ValueError:
            raise OTPError("The stored otpauth URI is malformed.") from None
        for field in ("secret", "algorithm", "digits", "period"):
            if field in parameters and (
                len(parameters[field]) != 1 or not parameters[field][0]
            ):
                raise OTPError("The otpauth URI has empty or duplicate OTP parameters.")
        if "secret" not in parameters:
            raise OTPError("The otpauth URI has no secret parameter.")
        raw = parameters["secret"][0]

    algorithm = algorithm or parameters.get("algorithm", ["SHA1"])[0].upper()
    if algorithm not in ("SHA1", "SHA256", "SHA512"):
        raise OTPError("Supported algorithms are SHA1, SHA256 and SHA512.")
    try:
        digits = int(digits if digits is not None else parameters.get("digits", [6])[0])
        period = int(period if period is not None else parameters.get("period", [30])[0])
    except (ValueError, TypeError):
        raise OTPError("Digits and period must be integers.") from None
    if digits not in (6, 8):
        raise OTPError("Digits must be 6 or 8.")
    if not 1 <= period <= 86400:
        raise OTPError("Period must be between 1 and 86400 seconds.")

    normalized = "".join(raw.upper().split())
    if not normalized:
        raise OTPError("The stored secret is empty.")
    normalized += "=" * ((8 - len(normalized) % 8) % 8)
    try:
        key = base64.b32decode(normalized, casefold=True)
    except (ValueError, binascii.Error):
        raise OTPError("The stored secret must be valid Base32 or a TOTP URI.") from None
    if not key:
        raise OTPError("The stored secret is empty.")
    return OTPConfig(key, algorithm, digits, period)


def generate_totp(config: OTPConfig, now: Optional[int] = None) -> tuple[str, int]:
    timestamp = int(time.time()) if now is None else now
    counter = timestamp // config.period
    digest = hmac.new(
        config.key, counter.to_bytes(8, "big"),
        getattr(hashlib, config.algorithm.lower()),
    ).digest()
    offset = digest[-1] & 0x0F
    value = int.from_bytes(digest[offset:offset + 4], "big") & 0x7FFFFFFF
    code = str(value % (10 ** config.digits)).zfill(config.digits)
    return code, config.period - timestamp % config.period


def copy_to_clipboard(value: str) -> None:
    subprocess.run(["/usr/bin/pbcopy"], input=value, text=True, check=True)


def parse_args(argv=None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Copy a TOTP from macOS Keychain to the clipboard."
    )
    parser.add_argument("--service", default="auth-otp", type=validate_identifier,
                        help="Keychain item name (default: auth-otp).")
    parser.add_argument("--account", default="default", type=validate_identifier,
                        help="Keychain account (default: default).")
    parser.add_argument("--keychain", type=Path,
                        default=Path.home() / "Library/Keychains/login.keychain-db",
                        help="Keychain file (default: your login keychain).")
    parser.add_argument("--algorithm", choices=("SHA1", "SHA256", "SHA512"),
                        help="Override the URI algorithm (Base32 default: SHA1).")
    parser.add_argument("--digits", type=int, choices=(6, 8),
                        help="Override the URI digits (Base32 default: 6).")
    parser.add_argument("--period", type=int,
                        help="Override the URI period (Base32 default: 30 seconds).")
    parser.add_argument("--check", action="store_true",
                        help="Validate without changing the clipboard.")
    parser.add_argument("--quiet", action="store_true", help="Suppress success output.")
    return parser.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(argv)
    if sys.platform != "darwin":
        print("auth-otp requires macOS.", file=sys.stderr)
        return 1
    try:
        raw = keychain_get(args.service, args.account, args.keychain)
        config = parse_secret(raw, args.algorithm, args.digits, args.period)
        code, remaining = generate_totp(config)
        if not args.check:
            copy_to_clipboard(code)
        if not args.quiet:
            print("OK: Keychain secret is readable and valid." if args.check else
                  f"OTP copied to clipboard. Valid for about {remaining}s.")
        return 0
    except OTPError as exc:
        print(f"auth-otp: {exc}", file=sys.stderr)
    except Exception:
        # Never echo subprocess stderr, URI input, or arbitrary exception values.
        print("auth-otp: Operation failed. Check macOS tools and Keychain access.",
              file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
